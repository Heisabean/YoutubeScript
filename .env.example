# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-proj-여기에_키를_입력하세요

# 기본 변환 모드 (api 또는 local)
DEFAULT_MODE=api

# 로컬 Whisper 모델 크기 (tiny, base, small, medium, large)
DEFAULT_MODEL=base

# MD 포맷팅용 API 키 (사용하는 LLM만 설정하면 됩니다)
# Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=여기에_키를_입력하세요
# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=여기에_키를_입력하세요

# 웹 서버 포트
PORT=8000
